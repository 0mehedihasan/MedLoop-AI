{
  "name": "medloop-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "MedLoop AI frontend — local human-in-the-loop medical imaging platform. Research prototype, not a medical device.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
