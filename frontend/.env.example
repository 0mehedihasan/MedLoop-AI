# MedLoop AI — frontend environment
#
# Copy to `.env.local` (gitignored) and adjust. Every value here is local-only by design;
# adding a hostname that is not on this machine violates CLAUDE.md §2.1.
#
#   cp .env.example .env.local

# Where the FastAPI backend is reachable. Must be an absolute URL — `next.config.ts`
# parses it to build the Content-Security-Policy, and a malformed value fails the build
# loudly rather than producing a CSP that blocks every request.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# `demo` renders the marked demo fixtures from `lib/demo/` behind a global banner and a
# per-screen badge. `api` removes all of it and the UI falls back to real empty states.
# There is no third value and no mixing of the two (CLAUDE.md §10).
NEXT_PUBLIC_DATA_SOURCE=demo

# Shown in the shell footer and the About panel so a screenshot is attributable to a build.
NEXT_PUBLIC_APP_VERSION=0.1.0
